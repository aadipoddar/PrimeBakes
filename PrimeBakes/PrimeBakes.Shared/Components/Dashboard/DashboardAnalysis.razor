<!-- KPI -->
<div class="launchpad-section">
	<h2 class="launchpad-section-title">Key Figures</h2>
	<div class="dashboard-grid">

		<FioriTile Title="Today's Revenue" Subtitle="@_todayRevenueTrend" KPI="@_todayRevenue" OnClick="() => NavigationManager.NavigateTo(StoreRouteNames.SaleReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
					<line x1="16" y1="2" x2="16" y2="6" />
					<line x1="8" y1="2" x2="8" y2="6" />
					<line x1="3" y1="10" x2="21" y2="10" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Revenue This Month" Subtitle="@_thisMonthRevenueTrend" KPI="@_thisMonthRevenue" OnClick="() => NavigationManager.NavigateTo(StoreRouteNames.OutletSummaryReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
					<polyline points="17 6 23 6 23 12" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Purchases This Month" Subtitle="@_thisMonthPurchaseTrend" KPI="@_thisMonthPurchase" OnClick="() => NavigationManager.NavigateTo(InventoryRouteNames.PurchaseReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="23 18 13.5 8.5 8.5 13.5 1 6" />
					<polyline points="17 18 23 18 23 12" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Money In &minus; Money Out" Subtitle="@_thisMonthNetTrend" KPI="@_thisMonthNet" OnClick="() => NavigationManager.NavigateTo(AccountsRouteNames.ProfitAndLossReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="20" x2="12" y2="10" />
					<line x1="18" y1="20" x2="18" y2="4" />
					<line x1="6" y1="20" x2="6" y2="16" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Sale Returns" Subtitle="@_thisMonthReturnsNote" KPI="@_thisMonthReturns" CustomColor="red" OnClick="() => NavigationManager.NavigateTo(StoreRouteNames.SaleReturnReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="1 4 1 10 7 10" />
					<path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Average Bill Value" Subtitle="@_thisMonthAverageBillTrend" KPI="@_thisMonthAverageBill" OnClick="() => NavigationManager.NavigateTo(StoreRouteNames.SaleReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="2" y="3" width="20" height="18" rx="2" />
					<line x1="7" y1="8" x2="17" y2="8" />
					<line x1="7" y1="12" x2="17" y2="12" />
					<line x1="7" y1="16" x2="13" y2="16" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Credit Sales" Subtitle="@_thisMonthCreditTrend" KPI="@_thisMonthCredit" OnClick="() => NavigationManager.NavigateTo(StoreRouteNames.CustomerSummaryReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="2" y="5" width="20" height="14" rx="2" ry="2" />
					<line x1="2" y1="10" x2="22" y2="10" />
					<line x1="6" y1="15" x2="10" y2="15" />
				</svg>
			</IconContent>
		</FioriTile>

		<FioriTile Title="Open On The Floor" Subtitle="@_openNote" KPI="@_openCount.ToString()" OnClick="() => NavigationManager.NavigateTo(StoreRouteNames.OrderReport)">
			<IconContent>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="10" />
					<polyline points="12 6 12 12 16 14" />
				</svg>
			</IconContent>
		</FioriTile>

	</div>
</div>

<DashboardChart />

<DashboardOutletSummary />

<!-- Summaries -->
<div class="launchpad-section attention-row">

	<div class="attention-col">
		<h2 class="launchpad-section-title">Kitchen Summary — Today</h2>
		<DashboardKitchenSummary />
	</div>

	<div class="attention-col">
		<h2 class="launchpad-section-title">Customer Summary — Today</h2>
		<DashboardCustomerSummary />
	</div>

</div>
