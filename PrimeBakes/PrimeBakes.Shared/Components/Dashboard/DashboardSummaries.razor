@using PrimeBakes.Library.Inventory.Kitchen.Models
@using PrimeBakes.Library.Store.Customer.Models
@using PrimeBakes.Library.Store.Sale.Models

<!-- Outlet -->
<div class="launchpad-section">
	<h2 class="launchpad-section-title">Outlet Summary — Today</h2>
	<div class="section-card">
		<SfGrid @ref="_outletGrid" TValue="OutletSummaryModel" DataSource="_outletSummaries"
				AllowTextWrap="true" AllowSorting="true" AllowResizing="true" AllowPaging="true"
				GridLines="GridLine.Horizontal" CssClass="professional-grid"
				ContextMenuItems="@_gridContextMenuItems"
				Toolbar="@(new List<string>() { "Search" })">

			<GridEvents TValue="OutletSummaryModel" ContextMenuItemClicked="OnOutletContextMenuItemClicked" />
			<GridPageSettings PageSize="5" PageSizes="@(new string[] { "5", "10", "20", "50", "All" })" />

			<GridAggregates>
				<GridAggregate>
					<GridAggregateColumns>
						<GridColumnAggregate Field="@nameof(OutletSummaryModel.Purchase)" />
						<GridColumnAggregate Field="@nameof(OutletSummaryModel.PurchaseReturn)" CustomColor="grid-debit" />
						<GridColumnAggregate Field="@nameof(OutletSummaryModel.KitchenIssue)" />
						<GridColumnAggregate Field="@nameof(OutletSummaryModel.KitchenIssueReturn)" CustomColor="grid-debit" />
						<GridColumnAggregate Field="@nameof(OutletSummaryModel.KitchenProduction)" />
						<GridColumnAggregate Field="@nameof(OutletSummaryModel.KitchenProductionReturn)" CustomColor="grid-debit" />
						<GridColumnAggregate Field="@nameof(OutletSummaryModel.Sale)" />
						<GridColumnAggregate Field="@nameof(OutletSummaryModel.SaleReturn)" CustomColor="grid-debit" />
					</GridAggregateColumns>
				</GridAggregate>
			</GridAggregates>

			<GridColumns>
				<CustomGridColumn Field="@nameof(OutletSummaryModel.LocationName)" HeaderText="Outlet" />
				<CustomGridColumn Field="@nameof(OutletSummaryModel.Purchase)" HeaderText="Purchase" NumericColumn="true" />
				<CustomGridColumn Field="@nameof(OutletSummaryModel.PurchaseReturn)" HeaderText="Purchase Return" CustomColor="grid-debit" />
				<CustomGridColumn Field="@nameof(OutletSummaryModel.KitchenIssue)" HeaderText="Kitchen Issue" NumericColumn="true" />
				<CustomGridColumn Field="@nameof(OutletSummaryModel.KitchenIssueReturn)" HeaderText="Kitchen Issue Return" CustomColor="grid-debit" />
				<CustomGridColumn Field="@nameof(OutletSummaryModel.KitchenProduction)" HeaderText="Kitchen Production" NumericColumn="true" />
				<CustomGridColumn Field="@nameof(OutletSummaryModel.KitchenProductionReturn)" HeaderText="Kitchen Production Return" CustomColor="grid-debit" />
				<CustomGridColumn Field="@nameof(OutletSummaryModel.Sale)" HeaderText="Sale" TotalColumn="true" />
				<CustomGridColumn Field="@nameof(OutletSummaryModel.SaleReturn)" HeaderText="Sale Return" CustomColor="grid-debit" />
			</GridColumns>
		</SfGrid>
	</div>
</div>

<!-- Kitchen & Customer, side by side -->
<div class="launchpad-section attention-row">

	<div class="attention-col">
		<h2 class="launchpad-section-title">Kitchen Summary — This Month</h2>
		<div class="section-card">
			<SfGrid @ref="_kitchenGrid" TValue="KitchenSummaryModel" DataSource="_kitchenSummaries"
					AllowTextWrap="true" AllowSorting="true" AllowResizing="true" AllowPaging="true"
					GridLines="GridLine.Horizontal" CssClass="professional-grid"
					ContextMenuItems="@_gridContextMenuItems"
					Toolbar="@(new List<string>() { "Search" })">

				<GridEvents TValue="KitchenSummaryModel" ContextMenuItemClicked="OnKitchenContextMenuItemClicked" />
				<GridPageSettings PageSize="5" PageSizes="@(new string[] { "5", "10", "20", "50", "All" })" />

				<GridAggregates>
					<GridAggregate>
						<GridAggregateColumns>
							<GridColumnAggregate Field="@nameof(KitchenSummaryModel.KitchenIssue)" />
							<GridColumnAggregate Field="@nameof(KitchenSummaryModel.KitchenIssueReturn)" CustomColor="grid-debit" />
							<GridColumnAggregate Field="@nameof(KitchenSummaryModel.KitchenProduction)" />
							<GridColumnAggregate Field="@nameof(KitchenSummaryModel.KitchenProductionReturn)" CustomColor="grid-debit" />
						</GridAggregateColumns>
					</GridAggregate>
				</GridAggregates>

				<GridColumns>
					<CustomGridColumn Field="@nameof(KitchenSummaryModel.KitchenName)" HeaderText="Kitchen" />
					<CustomGridColumn Field="@nameof(KitchenSummaryModel.KitchenIssue)" HeaderText="Kitchen Issue" NumericColumn="true" />
					<CustomGridColumn Field="@nameof(KitchenSummaryModel.KitchenIssueReturn)" HeaderText="Kitchen Issue Return" CustomColor="grid-debit" />
					<CustomGridColumn Field="@nameof(KitchenSummaryModel.KitchenProduction)" HeaderText="Kitchen Production" NumericColumn="true" />
					<CustomGridColumn Field="@nameof(KitchenSummaryModel.KitchenProductionReturn)" HeaderText="Kitchen Production Return" CustomColor="grid-debit" />
					<CustomGridColumn Field="@nameof(KitchenSummaryModel.KitchenProductionPercent)" HeaderText="Kitchen Production %" NumericColumn="true" />
				</GridColumns>
			</SfGrid>
		</div>
	</div>

	<div class="attention-col">
		<h2 class="launchpad-section-title">Customer Summary — This Month</h2>
		<div class="section-card">
			<SfGrid @ref="_customerGrid" TValue="CustomerSummaryModel" DataSource="_customerSummaries"
					AllowTextWrap="true" AllowSorting="true" AllowResizing="true" AllowPaging="true"
					GridLines="GridLine.Horizontal" CssClass="professional-grid"
					ContextMenuItems="@_gridContextMenuItems"
					Toolbar="@(new List<string>() { "Search" })">

				<GridEvents TValue="CustomerSummaryModel" ContextMenuItemClicked="OnCustomerContextMenuItemClicked" />
				<GridPageSettings PageSize="5" PageSizes="@(new string[] { "5", "10", "20", "50", "All" })" />

				<GridAggregates>
					<GridAggregate>
						<GridAggregateColumns>
							<GridColumnAggregate Field="@nameof(CustomerSummaryModel.GrossBusiness)" />
							<GridColumnAggregate Field="@nameof(CustomerSummaryModel.ReturnAmount)" CustomColor="grid-debit" />
							<GridColumnAggregate Field="@nameof(CustomerSummaryModel.NetBusiness)" />
						</GridAggregateColumns>
					</GridAggregate>
				</GridAggregates>

				<GridColumns>
					<CustomGridColumn Field="@nameof(CustomerSummaryModel.Name)" HeaderText="Customer" />
					<CustomGridColumn Field="@nameof(CustomerSummaryModel.PurchaseCount)" HeaderText="Bills" NumericColumn="true" Format="N0" />
					<CustomGridColumn Field="@nameof(CustomerSummaryModel.GrossBusiness)" HeaderText="Gross" NumericColumn="true" />
					<CustomGridColumn Field="@nameof(CustomerSummaryModel.ReturnAmount)" HeaderText="Returns" CustomColor="grid-debit" />
					<CustomGridColumn Field="@nameof(CustomerSummaryModel.NetBusiness)" HeaderText="Net Business" TotalColumn="true" />
					<CustomGridColumn Field="@nameof(CustomerSummaryModel.AverageOrderValue)" HeaderText="Avg Order" NumericColumn="true" />
					<CustomGridColumn Field="@nameof(CustomerSummaryModel.ContributionPercent)" HeaderText="Contribution %" NumericColumn="true" />
				</GridColumns>
			</SfGrid>
		</div>
	</div>

</div>
