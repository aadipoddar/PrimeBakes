@using System.Reflection
@using PrimeBakes.Models.DataAccess

<div class="footer-section">
    <div class="footer-content">
        <div class="device-info">

            @if (ShowVersion)
            {
                <span class="info-item version-info">
                    Version @(Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "1.0.0.0")
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(_platformInfo))
            {
                <span class="info-item platform-info">
                    @_platformInfo
                </span>
            }

            @if (_databaseLoad >= 0)
            {
                <span class="info-item load-info @DatabaseLoadClass">
                    Azure Load @_databaseLoad.ToString("N0")%
                </span>
            }

            @if (FormFactor.GetFormFactor() is "Desktop")
            {
                @if (_localDatabaseAvailable)
                {
                    <span class="info-item load-info load-low">
                        Local DB
                    </span>
                }

                @if (_lastSyncedAt is not null)
                {
                    <span class="info-item load-info @LastSyncedClass">
                        @LastSyncedText
                    </span>
                }
            }

        </div>
        <p class="copyright">
            &copy; @DateTime.Now.Year A Product By <a href="@CommonSecrets.AadiSoftWebsite" target="_blank" class="footer-link">AadiSoft</a>. All rights reserved.
        </p>
    </div>
</div>


<style>
    /* Footer Section */
    .footer-section {
        background: #ffffff;
        border-top: 1px solid #e2e8f0;
        padding: 12px 32px;
        margin-top: auto;
        box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.02);
    }

    .footer-content {
        display: flex;
        flex-direction: row;
        gap: 16px;
        align-items: center;
        justify-content: space-between;
    }

    .device-info {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: flex-start;
    }

    .info-item {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        color: #475569;
        padding: 4px 8px;
        background: #f8fafc;
        border-radius: 4px;
        border: 1px solid #e2e8f0;
        font-weight: 500;
    }

    .version-info {
        background: #dbeafe;
        color: #1e40af;
        border-color: #93c5fd;
    }

    .load-low {
        background: #dcfce7;
        color: #166534;
        border-color: #86efac;
    }

    .load-high {
        background: #fee2e2;
        color: #991b1b;
        border-color: #fca5a5;
    }

    .copyright {
        margin: 0;
        font-size: 13px;
        color: #64748b;
        font-weight: 400;
        white-space: nowrap;
    }

    .footer-link {
        color: #3b82f6;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .footer-link:hover {
            color: #2563eb;
            text-decoration: underline;
        }

    /* Mobile/Tablet - Hide platform and factor info on smaller displays */
    @@media (max-width: 768px) {
        .platform-info,
        .load-info {
            display: none;
        }

        .footer-content {
            flex-direction: column;
            gap: 8px;
            align-items: center;
        }

        .device-info {
            justify-content: center;
        }

        .copyright {
            text-align: center;
            white-space: normal;
        }
    }
</style>
