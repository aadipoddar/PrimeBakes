<div class="launchpad-section">

	<!-- Revenue (line) + Purchases (bar) trend -->
	<div class="chart-row">

		<div class="chart-card">
			<div class="chart-card-title">
				<span class="chart-dot dot-revenue"></span>
				<span>Revenue</span>
			</div>
			@if (_revenueSeries.Count == 0)
			{
				<div class="chart-empty">Loading…</div>
			}
			else
			{
				<MudBlazor.MudChart ChartType="MudBlazor.ChartType.Line"
									ChartSeries="@_revenueSeries"
									ChartLabels="@_labels"
									Width="100%"
									Height="100%"
									ChartOptions="@_revenueOptions" />
			}
		</div>

		<div class="chart-card">
			<div class="chart-card-title">
				<span class="chart-dot dot-purchase"></span>
				<span>Purchases</span>
			</div>
			@if (_purchaseSeries.Count == 0)
			{
				<div class="chart-empty">Loading…</div>
			}
			else
			{
				<MudBlazor.MudChart ChartType="MudBlazor.ChartType.Bar"
									ChartSeries="@_purchaseSeries"
									ChartLabels="@_labels"
									Width="100%"
									Height="100%"
									ChartOptions="@_purchaseOptions" />
			}
		</div>

	</div>

	<!-- Row 2: what sold + what it took to make it, this month -->
	<div class="chart-row">

		<div class="chart-card">
			<div class="chart-card-title">
				<span class="chart-dot dot-product"></span>
				<span>Top Products by Units — This Month</span>
			</div>
			@if (_productSeries.Count == 0)
			{
				<div class="chart-empty">Loading…</div>
			}
			else
			{
				<MudBlazor.MudChart ChartType="MudBlazor.ChartType.Bar"
									ChartSeries="@_productSeries"
									ChartLabels="@_productLabels"
									Width="100%"
									Height="100%"
									MatchBoundsToSize="true"
									ChartOptions="@_productOptions" />
			}
		</div>

		<div class="chart-card">
			<div class="chart-card-title">
				<span class="chart-dot dot-material"></span>
				<span>Top Raw Materials by Value — This Month</span>
			</div>
			@if (_materialSeries.Count == 0)
			{
				<div class="chart-empty">Loading…</div>
			}
			else
			{
				<MudBlazor.MudChart ChartType="MudBlazor.ChartType.Bar"
									ChartSeries="@_materialSeries"
									ChartLabels="@_materialLabels"
									Width="100%"
									Height="100%"
									MatchBoundsToSize="true"
									ChartOptions="@_materialOptions" />
			}
		</div>

	</div>

</div>
