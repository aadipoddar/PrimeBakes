<div class="launchpad-section">
	<h2 class="launchpad-section-title">AI Insights</h2>
	<div class="section-card">
		<div class="section-body">

			<div class="ai-chat-bar">
				<div class="ai-chat-input">
					<CustomTextField @bind-Value="_question"
									 Label="Ask about your business"
									 Placeholder="Leave empty for five short insights, or type a question."
									 Required="false"
									 ReadOnly="_isBusy"
									 Lines="2" />
				</div>

				<div class="ai-chat-send">
					<button type="button" class="ai-send-btn" disabled="@_isBusy" @onclick="Generate">
						@if (_isBusy)
						{
							<span class="ai-spinner"></span>
							<span>Thinking</span>
						}
						else
						{
							<span>Generate</span>
						}
					</button>
				</div>
			</div>

			<!-- Response, full width underneath -->
			<div class="ai-chat-answer">
				<CustomTextField Value="@_answer"
								 Label="Insights"
								 Placeholder="@(_isBusy ? "AI is thinking..." : "Press Generate to send your prompt to AI.")"
								 Required="false"
								 ReadOnly="true"
								 TabIndex="-1"
								 Lines="12" />
			</div>

		</div>
	</div>
</div>
