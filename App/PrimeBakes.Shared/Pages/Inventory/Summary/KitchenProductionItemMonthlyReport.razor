@using PrimeBakes.Models.Accounts.Masters
@using PrimeBakes.Models.Inventory.Kitchen
@using PrimeBakes.Models.Inventory.Kitchen.KitchenProduction
@using PrimeBakes.Models.Inventory.Summary
@using PrimeBakes.Models.Store.Product

@attribute [Route(InventoryRouteNames.KitchenProductionItemMonthlyReport)]

<PageTitle>Kitchen Production Item Monthly Report - Prime Bakes</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.KeyN KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => AuthenticationService.NavigateToRoute(InventoryRouteNames.KitchenProduction, FormFactor, JSRuntime, NavigationManager)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyF KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => _firstFocus?.FocusAsync()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.F5 OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyR KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyM KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleMeasure" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyT KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleTransactionReturns" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.Delete KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleDeleted" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyQ KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleDetailsView" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport(true)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyH KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => AuthenticationService.NavigateToRoute(InventoryRouteNames.KitchenProductionItemReport, FormFactor, JSRuntime, NavigationManager)" Disabled="@_isProcessing" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="Kitchen Production Item Monthly Report">
			<LeftContent>
				<MudBlazor.MudMenu Label="File" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="New Transaction (Ctrl + N)" OnClick="() => AuthenticationService.NavigateToRoute(InventoryRouteNames.KitchenProduction, FormFactor, JSRuntime, NavigationManager)" />
					<MudBlazor.MudMenuItem Label="Refresh Data (Ctrl + R / F5)" OnClick="LoadTransactionOverviews" />
					<MudBlazor.MudMenuItem Label="@(_showAmount ? "Show Quantity (Ctrl + M)" : "Show Amount (Ctrl + M)")" OnClick="ToggleMeasure" />
					<MudBlazor.MudMenuItem Label="@(_showDeleted ? "Hide Deleted (Ctrl + Delete)" : "Show Deleted (Ctrl + Delete)")" OnClick="ToggleDeleted" />
					<MudBlazor.MudMenuItem Label="@(_showTransactionReturns ? "Hide Returns (Ctrl + T)" : "Show Returns (Ctrl + T)")" OnClick="ToggleTransactionReturns" />
					<MudBlazor.MudMenuItem Label="@(_showAllColumns ? "Hide Details (Ctrl + Q)" : "Show Details (Ctrl + Q)")" OnClick="ToggleDetailsView" />
					<MudBlazor.MudDivider />
					<MudBlazor.MudMenuItem Label="Export PDF (Ctrl + P)" OnClick="() => ExportReport()" />
					<MudBlazor.MudMenuItem Label="Export Excel (Ctrl + E)" OnClick="() => ExportReport(true)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Open" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Kitchen Production (Ctrl + N)" OnClick="() => AuthenticationService.NavigateToRoute(InventoryRouteNames.KitchenProduction, FormFactor, JSRuntime, NavigationManager)" />
					<MudBlazor.MudMenuItem Label="Kitchen Production Report" OnClick="() => AuthenticationService.NavigateToRoute(InventoryRouteNames.KitchenProductionReport, FormFactor, JSRuntime, NavigationManager)" />
					<MudBlazor.MudMenuItem Label="Kitchen Production Item Report (Ctrl + H)" OnClick="() => AuthenticationService.NavigateToRoute(InventoryRouteNames.KitchenProductionItemReport, FormFactor, JSRuntime, NavigationManager)" />
					<MudBlazor.MudMenuItem Label="Kitchen Production Return Report" OnClick="() => AuthenticationService.NavigateToRoute(InventoryRouteNames.KitchenProductionReturnReport, FormFactor, JSRuntime, NavigationManager)" />
					<MudBlazor.MudMenuItem Label="Kitchen Production Return Item Report" OnClick="() => AuthenticationService.NavigateToRoute(InventoryRouteNames.KitchenProductionReturnItemReport, FormFactor, JSRuntime, NavigationManager)" />
					<MudBlazor.MudMenuItem Label="Kitchen Summary Report" OnClick="() => AuthenticationService.NavigateToRoute(InventoryRouteNames.KitchenSummaryReport, FormFactor, JSRuntime, NavigationManager)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Periods" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Current FY" OnClick="() => HandleDatesChanged(DateRangeType.CurrentFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Previous FY" OnClick="() => HandleDatesChanged(DateRangeType.PreviousFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Next FY" OnClick="() => HandleDatesChanged(DateRangeType.NextFinancialYear)" />
				</MudBlazor.MudMenu>
			</LeftContent>
		</Header>

		<div class="page-container">

			<div class="section-card">
				<div class="section-header">
					<h2 class="section-title">Filters</h2>
				</div>

				<div class="section-body">
					<div class="filters-grid">
						<!-- Product -->
						<div class="form-field">
							<CustomAutoComplete @ref="_firstFocus" T="ProductModel"
												Value="_selectedProduct"
												DataSource="@_products"
												Placeholder="All Items"
												Label="Item (Ctrl + F)" Required="false"
												ValueChanged="OnProductChanged"
												FieldValue="@nameof(ProductModel.Name)"
												AddNewRoute="@StoreRouteNames.Product" />
						</div>

						<!-- Product Category -->
						<div class="form-field">
							<CustomAutoComplete T="ProductCategoryModel"
												Value="_selectedProductCategory"
												DataSource="@_productCategories"
												Placeholder="All Categories"
												Label="Item Category" Required="false"
												ValueChanged="OnProductCategoryChanged"
												FieldValue="@nameof(ProductCategoryModel.Name)"
												AddNewRoute="@StoreRouteNames.ProductCategory" />
						</div>

						<!-- Company -->
						<div class="form-field">
							<CustomAutoComplete T="CompanyModel"
												Value="_selectedCompany"
												DataSource="@_companies"
												Placeholder="All Companies"
												Label="Company" Required="false"
												ValueChanged="OnCompanyChanged"
												FieldValue="@nameof(CompanyModel.Name)"
												AddNewRoute="@AccountsRouteNames.CompanyMaster" />
						</div>

						<!-- Kitchen -->
						<div class="form-field">
							<CustomAutoComplete T="KitchenModel"
												Value="_selectedKitchen"
												DataSource="@_kitchens"
												Placeholder="All Kitchens"
												Label="Kitchen" Required="false"
												ValueChanged="OnKitchenChanged"
												FieldValue="@nameof(KitchenModel.Name)"
												AddNewRoute="@InventoryRouteNames.Kitchen" />
						</div>
					</div>
				</div>
			</div>

			<div class="section-card">
				<div class="section-header">
					<h2 class="section-title">@_reportTitle</h2>
				</div>

				<SfGrid @ref="_sfGrid" TValue="KitchenProductionItemMonthlySummaryModel" DataSource="_monthlySummaries"
						AllowTextWrap="true" AllowPaging="true" AllowSorting="true" AllowResizing="true"
						AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
						GridLines="GridLine.Horizontal"
						Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

					<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
					<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

					<GridAggregates>
						<GridAggregate>
							<GridAggregateColumns>
								<GridColumnAggregate Field="@nameof(KitchenProductionItemMonthlySummaryModel.ItemName)" Type="AggregateType.Count" Format="N0" />
								@for (var index = 0; index < 12; index++)
								{
									var monthField = _monthFields[index];
									<GridColumnAggregate Field="@monthField" />
								}
								<GridColumnAggregate Field="@nameof(KitchenProductionItemMonthlySummaryModel.Total)" CustomColor="grid-total" />
								<GridColumnAggregate Field="@nameof(KitchenProductionItemMonthlySummaryModel.TotalQuantity)" />
								<GridColumnAggregate Field="@nameof(KitchenProductionItemMonthlySummaryModel.TotalAmount)" />
								<GridColumnAggregate Field="@nameof(KitchenProductionItemMonthlySummaryModel.ReturnQuantity)" CustomColor="grid-debit" />
								<GridColumnAggregate Field="@nameof(KitchenProductionItemMonthlySummaryModel.ReturnAmount)" CustomColor="grid-debit" />
								<GridColumnAggregate Field="@nameof(KitchenProductionItemMonthlySummaryModel.TransactionCount)" Format="N0" />
							</GridAggregateColumns>
						</GridAggregate>
					</GridAggregates>

					<GridColumns>
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.ItemName)" HeaderText="Item" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.ItemCode)" HeaderText="Code" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.ItemCategoryName)" HeaderText="Category" Visible="@(_selectedProductCategory is null || _selectedProductCategory.Id <= 0)" />

						@for (var index = 0; index < 12; index++)
						{
							var monthField = _monthFields[index];
							var monthHeader = _monthHeaders[index];
							<CustomGridColumn Field="@monthField" HeaderText="@monthHeader" Width="110" NumericColumn="true" />
						}

						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.Total)" HeaderText="Total" TotalColumn="true" />

						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.TotalQuantity)" HeaderText="Total Qty" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.TotalAmount)" HeaderText="Total Amount" Visible="@_showAllColumns" TotalColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.AverageRate)" HeaderText="Avg Rate" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.MinimumRate)" HeaderText="Min Rate" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.MaximumRate)" HeaderText="Max Rate" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.LastRate)" HeaderText="Last Rate" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.RateVariancePercent)" HeaderText="Rate Swing %" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.ReturnQuantity)" HeaderText="Return Qty" Visible="@_showAllColumns" CustomColor="grid-debit" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.ReturnAmount)" HeaderText="Return Amount" Visible="@_showAllColumns" CustomColor="grid-debit" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.ReturnPercent)" HeaderText="Return %" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.TransactionCount)" HeaderText="Productions" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.KitchenCount)" HeaderText="Kitchens" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.Rank)" HeaderText="Rank" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.ContributionPercent)" HeaderText="Share %" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.ActiveMonths)" HeaderText="Active Months" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.AveragePerMonth)" HeaderText="Avg / Month" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.AveragePerActiveMonth)" HeaderText="Avg / Active Month" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.AveragePerTransaction)" HeaderText="Avg / Production" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.PeakMonthName)" HeaderText="Peak Month" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.PeakMonthValue)" HeaderText="Peak Value" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.LowestMonthName)" HeaderText="Lowest Month" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.LowestMonthValue)" HeaderText="Lowest Value" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.Quarter1)" HeaderText="Q1" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.Quarter2)" HeaderText="Q2" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.Quarter3)" HeaderText="Q3" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.Quarter4)" HeaderText="Q4" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.FirstHalf)" HeaderText="H1" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.SecondHalf)" HeaderText="H2" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.GrowthPercent)" HeaderText="H2 vs H1 %" Visible="@_showAllColumns" NegativePositiveColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.RecentTrendPercent)" HeaderText="Q4 vs Q3 %" Visible="@_showAllColumns" NegativePositiveColumn="true" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.ConsistencyPercent)" HeaderText="Consistency %" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.FirstProductionDateTime)" HeaderText="First Production" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.LastProductionDateTime)" HeaderText="Last Production" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(KitchenProductionItemMonthlySummaryModel.MonthsSinceLastProduction)" HeaderText="Months Idle" Visible="@_showAllColumns" NumericColumn="true" />
					</GridColumns>
				</SfGrid>
			</div>
		</div>

		<Footer />
	</div>
}

<ToastNotification @ref="_toastNotification" />

<CloseGuard Block="_isProcessing" />
