@using PrimeBakes.Models.Accounts.Masters
@using PrimeBakes.Models.Inventory.Purchase
@using PrimeBakes.Models.Inventory.RawMaterial
@using PrimeBakes.Models.Inventory.Summary

@attribute [Route(InventoryRouteNames.PurchaseItemMonthlyReport)]

<PageTitle>Purchase Item Monthly Report - Prime Bakes</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.KeyN KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => WindowNavigation.NavigateToRoute(InventoryRouteNames.Purchase)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyF KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => _firstFocus?.FocusAsync()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.F5 OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyR KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyM KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleMeasure" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyT KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleTransactionReturns" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.Delete KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleDeleted" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyQ KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleDetailsView" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport(true)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyH KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => WindowNavigation.NavigateToRoute(InventoryRouteNames.PurchaseItemReport)" Disabled="@_isProcessing" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="Purchase Item Monthly Report">
			<LeftContent>
				<MudBlazor.MudMenu Label="File" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="New Transaction (Ctrl + N)" OnClick="() => WindowNavigation.NavigateToRoute(InventoryRouteNames.Purchase)" />
					<MudBlazor.MudMenuItem Label="Refresh Data (Ctrl + R / F5)" OnClick="LoadTransactionOverviews" />
					<MudBlazor.MudMenuItem Label="@(_showAmount ? "Show Quantity (Ctrl + M)" : "Show Amount (Ctrl + M)")" OnClick="ToggleMeasure" />
					<MudBlazor.MudMenuItem Label="@(_showDeleted ? "Hide Deleted (Ctrl + Delete)" : "Show Deleted (Ctrl + Delete)")" OnClick="ToggleDeleted" />
					<MudBlazor.MudMenuItem Label="@(_showTransactionReturns ? "Hide Returns (Ctrl + T)" : "Show Returns (Ctrl + T)")" OnClick="ToggleTransactionReturns" />
					<MudBlazor.MudMenuItem Label="@(_showAllColumns ? "Hide Details (Ctrl + Q)" : "Show Details (Ctrl + Q)")" OnClick="ToggleDetailsView" />
					<MudBlazor.MudDivider />
					<MudBlazor.MudMenuItem Label="Export PDF (Ctrl + P)" OnClick="() => ExportReport()" />
					<MudBlazor.MudMenuItem Label="Export Excel (Ctrl + E)" OnClick="() => ExportReport(true)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Open" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Purchase (Ctrl + N)" OnClick="() => WindowNavigation.NavigateToRoute(InventoryRouteNames.Purchase)" />
					<MudBlazor.MudMenuItem Label="Purchase Report" OnClick="() => WindowNavigation.NavigateToRoute(InventoryRouteNames.PurchaseReport)" />
					<MudBlazor.MudMenuItem Label="Purchase Item Report (Ctrl + H)" OnClick="() => WindowNavigation.NavigateToRoute(InventoryRouteNames.PurchaseItemReport)" />
					<MudBlazor.MudMenuItem Label="Purchase Return Report" OnClick="() => WindowNavigation.NavigateToRoute(InventoryRouteNames.PurchaseReturnReport)" />
					<MudBlazor.MudMenuItem Label="Purchase Return Item Report" OnClick="() => WindowNavigation.NavigateToRoute(InventoryRouteNames.PurchaseReturnItemReport)" />
					<MudBlazor.MudMenuItem Label="Purchase Order Report" OnClick="() => WindowNavigation.NavigateToRoute(InventoryRouteNames.PurchaseOrderReport)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Periods" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Current FY" OnClick="() => HandleDatesChanged(DateRangeType.CurrentFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Previous FY" OnClick="() => HandleDatesChanged(DateRangeType.PreviousFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Next FY" OnClick="() => HandleDatesChanged(DateRangeType.NextFinancialYear)" />
				</MudBlazor.MudMenu>
			</LeftContent>
		</Header>

		<div class="page-container">

			<div class="section-card">
				<div class="section-header">
					<h2 class="section-title">Filters</h2>
				</div>

				<div class="section-body">
					<div class="filters-grid">
						<!-- Raw Material -->
						<div class="form-field">
							<CustomAutoComplete @ref="_firstFocus" T="RawMaterialModel"
												Value="_selectedRawMaterial"
												DataSource="@_rawMaterials"
												Placeholder="All Items"
												Label="Item (Ctrl + F)" Required="false"
												ValueChanged="OnRawMaterialChanged"
												FieldValue="@nameof(RawMaterialModel.Name)"
												AddNewRoute="@InventoryRouteNames.RawMaterial" />
						</div>

						<!-- Raw Material Category -->
						<div class="form-field">
							<CustomAutoComplete T="RawMaterialCategoryModel"
												Value="_selectedRawMaterialCategory"
												DataSource="@_rawMaterialCategories"
												Placeholder="All Categories"
												Label="Item Category" Required="false"
												ValueChanged="OnRawMaterialCategoryChanged"
												FieldValue="@nameof(RawMaterialCategoryModel.Name)"
												AddNewRoute="@InventoryRouteNames.RawMaterialCategory" />
						</div>

						<!-- Company -->
						<div class="form-field">
							<CustomAutoComplete T="CompanyModel"
												Value="_selectedCompany"
												DataSource="@_companies"
												Placeholder="All Companies"
												Label="Company" Required="false"
												ValueChanged="OnCompanyChanged"
												FieldValue="@nameof(CompanyModel.Name)"
												AddNewRoute="@AccountsRouteNames.CompanyMaster" />
						</div>

						<!-- Party -->
						<div class="form-field">
							<CustomAutoComplete T="LedgerModel"
												Value="_selectedParty"
												DataSource="@_parties"
												Placeholder="All Parties"
												Label="Party" Required="false"
												ValueChanged="OnPartyChanged"
												FieldValue="@nameof(LedgerModel.Name)"
												AddNewRoute="@AccountsRouteNames.LedgerMaster" />
						</div>
					</div>
				</div>
			</div>

			<div class="section-card">
				<div class="section-header">
					<h2 class="section-title">@_reportTitle</h2>
				</div>

				<SfGrid @ref="_sfGrid" TValue="PurchaseItemMonthlySummaryModel" DataSource="_monthlySummaries"
						AllowTextWrap="true" AllowPaging="true" AllowSorting="true" AllowResizing="true"
						AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
						GridLines="GridLine.Horizontal"
						Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

					<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
					<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

					<GridAggregates>
						<GridAggregate>
							<GridAggregateColumns>
								<GridColumnAggregate Field="@nameof(PurchaseItemMonthlySummaryModel.ItemName)" Type="AggregateType.Count" Format="N0" />
								@for (var index = 0; index < 12; index++)
								{
									var monthField = _monthFields[index];
									<GridColumnAggregate Field="@monthField" />
								}
								<GridColumnAggregate Field="@nameof(PurchaseItemMonthlySummaryModel.Total)" CustomColor="grid-total" />
								<GridColumnAggregate Field="@nameof(PurchaseItemMonthlySummaryModel.TotalQuantity)" />
								<GridColumnAggregate Field="@nameof(PurchaseItemMonthlySummaryModel.TotalAmount)" />
								<GridColumnAggregate Field="@nameof(PurchaseItemMonthlySummaryModel.DiscountAmount)" CustomColor="grid-debit" />
								<GridColumnAggregate Field="@nameof(PurchaseItemMonthlySummaryModel.TaxAmount)" />
								<GridColumnAggregate Field="@nameof(PurchaseItemMonthlySummaryModel.ReturnQuantity)" CustomColor="grid-debit" />
								<GridColumnAggregate Field="@nameof(PurchaseItemMonthlySummaryModel.ReturnAmount)" CustomColor="grid-debit" />
								<GridColumnAggregate Field="@nameof(PurchaseItemMonthlySummaryModel.TransactionCount)" Format="N0" />
							</GridAggregateColumns>
						</GridAggregate>
					</GridAggregates>

					<GridColumns>
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.ItemName)" HeaderText="Item" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.ItemCode)" HeaderText="Code" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.ItemCategoryName)" HeaderText="Category" Visible="@(_selectedRawMaterialCategory is null || _selectedRawMaterialCategory.Id <= 0)" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.UnitOfMeasurement)" HeaderText="UOM" TextAlign="TextAlign.Center" Visible="@_showAllColumns" />

						@for (var index = 0; index < 12; index++)
						{
							var monthField = _monthFields[index];
							var monthHeader = _monthHeaders[index];
							<CustomGridColumn Field="@monthField" HeaderText="@monthHeader" Width="110" NumericColumn="true" />
						}

						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.Total)" HeaderText="Total" TotalColumn="true" />

						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.TotalQuantity)" HeaderText="Total Qty" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.TotalAmount)" HeaderText="Total Amount" Visible="@_showAllColumns" TotalColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.AverageRate)" HeaderText="Avg Rate" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.MinimumRate)" HeaderText="Min Rate" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.MaximumRate)" HeaderText="Max Rate" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.LastRate)" HeaderText="Last Rate" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.RateVariancePercent)" HeaderText="Rate Swing %" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.DiscountAmount)" HeaderText="Discount" Visible="@_showAllColumns" CustomColor="grid-debit" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.TaxAmount)" HeaderText="Tax" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.ReturnQuantity)" HeaderText="Return Qty" Visible="@_showAllColumns" CustomColor="grid-debit" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.ReturnAmount)" HeaderText="Return Amount" Visible="@_showAllColumns" CustomColor="grid-debit" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.ReturnPercent)" HeaderText="Return %" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.TransactionCount)" HeaderText="Purchases" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.PartyCount)" HeaderText="Suppliers" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.Rank)" HeaderText="Rank" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.ContributionPercent)" HeaderText="Share %" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.ActiveMonths)" HeaderText="Active Months" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.AveragePerMonth)" HeaderText="Avg / Month" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.AveragePerActiveMonth)" HeaderText="Avg / Active Month" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.AveragePerTransaction)" HeaderText="Avg / Purchase" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.PeakMonthName)" HeaderText="Peak Month" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.PeakMonthValue)" HeaderText="Peak Value" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.LowestMonthName)" HeaderText="Lowest Month" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.LowestMonthValue)" HeaderText="Lowest Value" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.Quarter1)" HeaderText="Q1" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.Quarter2)" HeaderText="Q2" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.Quarter3)" HeaderText="Q3" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.Quarter4)" HeaderText="Q4" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.FirstHalf)" HeaderText="H1" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.SecondHalf)" HeaderText="H2" Visible="@_showAllColumns" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.GrowthPercent)" HeaderText="H2 vs H1 %" Visible="@_showAllColumns" NegativePositiveColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.RecentTrendPercent)" HeaderText="Q4 vs Q3 %" Visible="@_showAllColumns" NegativePositiveColumn="true" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.ConsistencyPercent)" HeaderText="Consistency %" Visible="@_showAllColumns" NumericColumn="true" />

						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.FirstPurchaseDateTime)" HeaderText="First Purchase" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.LastPurchaseDateTime)" HeaderText="Last Purchase" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />
						<CustomGridColumn Field="@nameof(PurchaseItemMonthlySummaryModel.MonthsSinceLastPurchase)" HeaderText="Months Idle" Visible="@_showAllColumns" NumericColumn="true" />
					</GridColumns>
				</SfGrid>
			</div>
		</div>

		<Footer />
	</div>
}

<ToastNotification @ref="_toastNotification" />

<CloseGuard Block="_isProcessing" />
