@using PrimeBakes.Models.Accounts.Masters
@using PrimeBakes.Models.Payroll.Masters
@using PrimeBakes.Models.Payroll.PayrollRun

@attribute [Route(PayrollRouteNames.PayrollItemReport)]

<PageTitle>Payroll Component Report - Prime Bakes</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.KeyN KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => WindowNavigation.NavigateToRoute(PayrollRouteNames.Payroll)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyF KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => _firstFocus?.FocusAsync()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.F5 OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyR KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyQ KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleDetailsView" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyW KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleSummary" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyT KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleInfoComponents" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport(true)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyI KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => WindowNavigation.NavigateToRoute(PayrollRouteNames.PayrollReport)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.AltLeft] OnHotkeyPressed="() => ExportSelectedPayslip()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.AltLeft] OnHotkeyPressed="() => ExportSelectedPayslip(true)" Disabled="@_isProcessing" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="Payroll Component Report">
			<LeftContent>
				<MudBlazor.MudMenu Label="File" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="New Transaction (Ctrl + N)" OnClick="() => WindowNavigation.NavigateToRoute(PayrollRouteNames.Payroll)" />
					<MudBlazor.MudMenuItem Label="Refresh Data (Ctrl + R / F5)" OnClick="LoadTransactionOverviews" />
					<MudBlazor.MudMenuItem Label="@(_showSummary ? "Hide Summary (Ctrl + W)" : "Show Summary (Ctrl + W)")" OnClick="ToggleSummary" />
					<MudBlazor.MudMenuItem Label="@(_showInfoComponents ? "Hide Calculated Totals (Ctrl + T)" : "Show Calculated Totals (Ctrl + T)")" OnClick="ToggleInfoComponents" />
					<MudBlazor.MudMenuItem Label="@(_showAllColumns ? "Hide Details (Ctrl + Q)" : "Show Details (Ctrl + Q)")" OnClick="ToggleDetailsView" />
					<MudBlazor.MudDivider />
					<MudBlazor.MudMenuItem Label="Export PDF (Ctrl + P)" OnClick="() => ExportReport()" />
					<MudBlazor.MudMenuItem Label="Export Excel (Ctrl + E)" OnClick="() => ExportReport(true)" />
					<MudBlazor.MudDivider />
					<MudBlazor.MudMenuItem Label="Export Payroll PDF" OnClick="() => ExportPayrollReport()" />
					<MudBlazor.MudMenuItem Label="Export Payroll Excel" OnClick="() => ExportPayrollReport(true)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Open" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Payroll (Ctrl + N)" OnClick="() => WindowNavigation.NavigateToRoute(PayrollRouteNames.Payroll)" />
					<MudBlazor.MudMenuItem Label="Payroll Report (Ctrl + I)" OnClick="() => WindowNavigation.NavigateToRoute(PayrollRouteNames.PayrollReport)" />
					<MudBlazor.MudMenuItem Label="Payroll Component Report" OnClick="() => WindowNavigation.NavigateToRoute(PayrollRouteNames.PayrollItemReport)" />
					<MudBlazor.MudMenuItem Label="Attendance" OnClick="() => WindowNavigation.NavigateToRoute(PayrollRouteNames.Attendance)" />
					<MudBlazor.MudMenuItem Label="Salary Component" OnClick="() => WindowNavigation.NavigateToRoute(PayrollRouteNames.SalaryComponent)" />
					<MudBlazor.MudMenuItem Label="Employee Salary Component" OnClick="() => WindowNavigation.NavigateToRoute(PayrollRouteNames.EmployeeSalaryComponent)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Periods" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Current Month" OnClick="() => HandleDatesChanged(DateRangeType.CurrentMonth)" />
					<MudBlazor.MudMenuItem Label="Previous Month" OnClick="() => HandleDatesChanged(DateRangeType.PreviousMonth)" />
					<MudBlazor.MudMenuItem Label="Next Month" OnClick="() => HandleDatesChanged(DateRangeType.NextMonth)" />
					<MudBlazor.MudMenuItem Label="Current FY" OnClick="() => HandleDatesChanged(DateRangeType.CurrentFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Previous FY" OnClick="() => HandleDatesChanged(DateRangeType.PreviousFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Next FY" OnClick="() => HandleDatesChanged(DateRangeType.NextFinancialYear)" />
					<MudBlazor.MudMenuItem Label="All Time" OnClick="() => HandleDatesChanged(DateRangeType.AllTime)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Transaction" Dense="true" Disabled="_isProcessing || _showSummary">
					<MudBlazor.MudMenuItem Label="Export Payslip PDF (Alt + P)" OnClick="() => ExportSelectedPayslip()" />
					<MudBlazor.MudMenuItem Label="Export Payslip Excel (Alt + E)" OnClick="() => ExportSelectedPayslip(true)" />
				</MudBlazor.MudMenu>
			</LeftContent>
		</Header>

		<div class="page-container">

			<div class="section-card">
				<div class="section-header">
					<h2 class="section-title">Filters</h2>
				</div>

				<div class="section-body">
					<div class="filters-grid">
						<div class="form-field">
							<CustomDateRangePicker @ref="_firstFocus" Value="@(new MudBlazor.DateRange(_fromDate, _toDate))"
												   ValueChanged="OnDateRangeChanged"
												   Label="Date Range (Ctrl + F)"
												   Required="false" />
						</div>

						<div class="form-field">
							<CustomAutoComplete T="EmployeeModel"
												Value="_selectedEmployee"
												DataSource="@_employees"
												Placeholder="All Employees"
												Label="Employee" Required="false"
												ValueChanged="OnEmployeeChanged"
												FieldValue="@nameof(EmployeeModel.Name)"
												AddNewRoute="@PayrollRouteNames.Employee" />
						</div>

						<div class="form-field">
							<CustomAutoComplete T="DepartmentModel"
												Value="_selectedDepartment"
												DataSource="@_departments"
												Placeholder="All Departments"
												Label="Department" Required="false"
												ValueChanged="OnDepartmentChanged"
												FieldValue="@nameof(DepartmentModel.Name)"
												AddNewRoute="@PayrollRouteNames.Department" />
						</div>

						<div class="form-field">
							<CustomAutoComplete T="SalaryComponentModel"
												Value="_selectedSalaryComponent"
												DataSource="@_salaryComponents"
												Placeholder="All Components"
												Label="Salary Component" Required="false"
												ValueChanged="OnSalaryComponentChanged"
												FieldValue="@nameof(SalaryComponentModel.Name)"
												AddNewRoute="@PayrollRouteNames.SalaryComponent" />
						</div>
					</div>
				</div>
			</div>

			<div class="section-card">
				<div class="section-header">
					<h2 class="section-title">Records</h2>
				</div>

				<SfGrid @ref="_sfGrid" TValue="PayrollItemOverviewModel" DataSource="_transactionOverviews"
						AllowTextWrap="true" AllowPaging="true" AllowSorting="true" AllowResizing="true"
						AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
						GridLines="GridLine.Horizontal" ContextMenuItems="@_gridContextMenuItems"
						Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

					<GridEvents TValue="PayrollItemOverviewModel" ContextMenuItemClicked="OnGridContextMenuItemClicked" />
					<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
					<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

					<GridAggregates>
						<GridAggregate>
							<GridAggregateColumns>
								<GridColumnAggregate Field="@nameof(PayrollItemOverviewModel.SalaryComponentCode)" Type="AggregateType.Count" Format="N0" />
								<GridColumnAggregate Field="@nameof(PayrollItemOverviewModel.Amount)" CustomColor="grid-total" />
							</GridAggregateColumns>
						</GridAggregate>
					</GridAggregates>

					<GridColumns>
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.TransactionNo)" HeaderText="Transaction No" Visible="@(_showAllColumns && !_showSummary)" />
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.EmployeeCode)" HeaderText="Employee Code" Visible="@(!_showSummary && (_showAllColumns || _selectedEmployee is null || _selectedEmployee.Id <= 0))" />
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.EmployeeName)" HeaderText="Employee" Visible="@(!_showSummary && (_showAllColumns || _selectedEmployee is null || _selectedEmployee.Id <= 0))" />
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.TransactionDateTime)" HeaderText="Period" Format="MMM yyyy" Type="ColumnType.DateTime" Visible="@(!_showSummary)" />

						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.SalaryComponentCode)" HeaderText="Code" Width="150" />
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.SalaryComponentName)" HeaderText="Component" />
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.SalaryComponentType)" HeaderText="Type" Width="180" />
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.Amount)" HeaderText="Amount" TotalColumn="true" />

						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.Formula)" HeaderText="Formula" Visible="@(_showAllColumns && !_showSummary)" />
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.Prorate)" HeaderText="Prorate" Width="120" TextAlign="TextAlign.Center" DisplayAsCheckBox="true" Type="ColumnType.Boolean" Visible="@(_showAllColumns && !_showSummary)" />
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.PaidDays)" HeaderText="Paid Days" Visible="@(_showAllColumns && !_showSummary)" NumericColumn="true" />
						<CustomGridColumn Field="@nameof(PayrollItemOverviewModel.NetPay)" HeaderText="Net Pay" Visible="@(_showAllColumns && !_showSummary)" TotalColumn="true" />
					</GridColumns>
				</SfGrid>
			</div>
		</div>

		<Footer />
	</div>
}

<ToastNotification @ref="_toastNotification" />

<CloseGuard Block="_isProcessing" />
