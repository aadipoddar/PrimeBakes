@using PrimeBakes.Models.Accounts.Masters
@using PrimeBakes.Models.Restaurant.Bill
@using PrimeBakes.Models.Store.Sale
@using PrimeBakes.Models.Store.StockTransfer
@using PrimeBakes.Shared.Components.Ai

@attribute [Route(OperationRouteNames.FallacyReport)]

<PageTitle>Fallacy Report - Prime Bakes</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.F5 OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyR KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyJ KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleAi" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport(true)" Disabled="@_isProcessing" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="Fallacy Report">
			<LeftContent>
				<MudBlazor.MudMenu Label="File" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Refresh Data (Ctrl + R / F5)" OnClick="LoadTransactionOverviews" />
					<MudBlazor.MudMenuItem Label="@(_showAi ? "Hide AI Insights (Ctrl + J)" : "Show AI Insights (Ctrl + J)")" OnClick="ToggleAi" />
					<MudBlazor.MudDivider />
					<MudBlazor.MudMenuItem Label="Export PDF (Ctrl + P)" OnClick="() => ExportReport()" />
					<MudBlazor.MudMenuItem Label="Export Excel (Ctrl + E)" OnClick="() => ExportReport(true)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Periods" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Current FY" OnClick="() => HandleDatesChanged(DateRangeType.CurrentFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Previous FY" OnClick="() => HandleDatesChanged(DateRangeType.PreviousFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Next FY" OnClick="() => HandleDatesChanged(DateRangeType.NextFinancialYear)" />
				</MudBlazor.MudMenu>
			</LeftContent>
		</Header>

		<div class="page-container fallacy-tabs">

			@if (_showAi)
			{
				<ReportAi Instructions="@AiInstructions"
						  GetContext="BuildAiContext"
						  ReportName="@OperationRouteNames.FallacyReport"
						  UserId="@_user.Id"
						  DefaultQuestion="@AiDefaultQuestion"
						  Suggestions="@AiSuggestions" />
			}

			<MudBlazor.MudTabs @bind-ActivePanelIndex="_activeTabIndex"
							   Rounded="true"
							   Color="MudBlazor.Color.Transparent"
							   SliderColor="MudBlazor.Color.Primary"
							   MinimumTabWidth="120px"
							   ApplyEffectsToContainer="false"
							   TabHeaderClass="fallacy-tab-header"
							   TabPanelsClass="fallacy-tab-panels">

				<!-- 1. Sale: main outlet to outlet -->
				<MudBlazor.MudTabPanel Text="@($"Sale - Main Outlet ({_fallacyDiscountMainOutletSaleOverviews.Count})")">
					<div class="section-card">
						<div class="section-header">
							<h2 class="section-title">Main outlet sales where the discount is not equal to the outlet's discount</h2>
						</div>

						<SfGrid @ref="_sfGridMainOutletSale" TValue="SaleOverviewModel" DataSource="_fallacyDiscountMainOutletSaleOverviews"
								AllowTextWrap="true" AllowPaging="true" AllowSorting="true" AllowResizing="true"
								AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
								GridLines="GridLine.Horizontal" ContextMenuItems="@_gridContextMenuItems"
								Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

							<GridEvents TValue="SaleOverviewModel" ContextMenuItemClicked="OnSaleContextMenuItemClicked" />
							<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
							<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

							<GridAggregates>
								<GridAggregate>
									<GridAggregateColumns>
										<GridColumnAggregate Field="@nameof(SaleOverviewModel.TransactionNo)" Type="AggregateType.Count" Format="N0" />
										<GridColumnAggregate Field="@nameof(SaleOverviewModel.DiscountAmount)" CustomColor="grid-debit" />
										<GridColumnAggregate Field="@nameof(SaleOverviewModel.TotalAmount)" CustomColor="grid-total" />
									</GridAggregateColumns>
								</GridAggregate>
							</GridAggregates>

							<GridColumns>
								<CustomGridColumn Field="@nameof(SaleOverviewModel.TransactionNo)" HeaderText="Transaction No" />
								<CustomGridColumn Field="@nameof(SaleOverviewModel.TransactionDateTime)" HeaderText="Date" Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime" />
								<CustomGridColumn Field="@nameof(SaleOverviewModel.LocationName)" HeaderText="Location" />
								<CustomGridColumn Field="@nameof(SaleOverviewModel.PartyName)" HeaderText="Party" />
								<CustomGridColumn Field="@nameof(SaleOverviewModel.DiscountPercent)" HeaderText="Disc %" CustomColor="grid-debit" />
								<CustomGridColumn Field="@nameof(SaleOverviewModel.DiscountAmount)" HeaderText="Disc" CustomColor="grid-debit" />
								<CustomGridColumn Field="@nameof(SaleOverviewModel.TotalAmount)" HeaderText="Total" TotalColumn="true" />
								<CustomGridColumn Field="@nameof(SaleOverviewModel.CreatedByName)" HeaderText="Created By" />
							</GridColumns>
						</SfGrid>
					</div>
				</MudBlazor.MudTabPanel>

				<!-- 2. Sale Return: main outlet to outlet -->
