								<CustomGridColumn Field="@nameof(SaleReturnOverviewModel.LocationName)" HeaderText="Location" />
								<CustomGridColumn Field="@nameof(SaleReturnOverviewModel.PartyName)" HeaderText="Party" />
								<CustomGridColumn Field="@nameof(SaleReturnOverviewModel.DiscountPercent)" HeaderText="Disc %" CustomColor="grid-debit" />
								<CustomGridColumn Field="@nameof(SaleReturnOverviewModel.DiscountAmount)" HeaderText="Disc" CustomColor="grid-debit" />
								<CustomGridColumn Field="@nameof(SaleReturnOverviewModel.TotalAmount)" HeaderText="Total" TotalColumn="true" />
								<CustomGridColumn Field="@nameof(SaleReturnOverviewModel.CreatedByName)" HeaderText="Created By" />
							</GridColumns>
