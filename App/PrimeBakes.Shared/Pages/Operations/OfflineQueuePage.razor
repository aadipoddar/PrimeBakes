@using PrimeBakes.Models.Operations.OfflineQueue

@attribute [Route(OperationRouteNames.OfflineQueue)]

<PageTitle>Offline Queue - Prime Bakes</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.F5 OnHotkeyPressed="LoadOfflineQueues" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyR KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="LoadOfflineQueues" Disabled="@_isProcessing" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="Offline Queue">
			<LeftContent>
				<MudBlazor.MudMenu Label="File" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Refresh Data (Ctrl + R / F5)" OnClick="LoadOfflineQueues" />
				</MudBlazor.MudMenu>
			</LeftContent>
		</Header>

		<div class="page-container">

			<div class="section-card">
				<div class="section-header">
					<h2 class="section-title">Pending Transactions</h2>
				</div>

				<SfGrid @ref="_sfGrid" TValue="OfflineQueueModel" DataSource="_offlineQueues"
						AllowTextWrap="false" AllowPaging="true" AllowSorting="true" AllowResizing="true"
						AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
						GridLines="GridLine.Horizontal"
						Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

					<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
					<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

					<GridAggregates>
						<GridAggregate>
							<GridAggregateColumns>
								<GridColumnAggregate Field="@nameof(OfflineQueueModel.Id)" Type="AggregateType.Count" Format="N0" />
							</GridAggregateColumns>
						</GridAggregate>
					</GridAggregates>

					<GridColumns>
						<CustomGridColumn Field="@nameof(OfflineQueueModel.Id)" HeaderText="Id" Format="N0" NumericColumn="true" Width="100" />
						<CustomGridColumn Field="@nameof(OfflineQueueModel.TableName)" HeaderText="Table" Width="150" />
						<CustomGridColumn Field="@nameof(OfflineQueueModel.TransactionNo)" HeaderText="Transaction No" Width="200" />
						<CustomGridColumn Field="@nameof(OfflineQueueModel.Payload)" HeaderText="Payload" Width="600" />
					</GridColumns>
				</SfGrid>
			</div>
		</div>

		<Footer />
	</div>
}

<ToastNotification @ref="_toastNotification" />

<CloseGuard Block="_isProcessing" />
