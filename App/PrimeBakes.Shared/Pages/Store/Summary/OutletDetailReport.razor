@using PrimeBakes.Models.Accounts.FinancialAccounting
@using PrimeBakes.Models.Accounts.Masters
@using PrimeBakes.Models.Inventory.Stock
@using PrimeBakes.Models.Operations.Location
@using PrimeBakes.Models.Restaurant.Bill
@using PrimeBakes.Models.Store.Order
@using PrimeBakes.Models.Store.Product
@using PrimeBakes.Models.Store.Sale
@using PrimeBakes.Models.Store.StockTransfer
@using PrimeBakes.Shared.Components.Ai

@attribute [Route(StoreRouteNames.OutletDetailReport)]

<PageTitle>Outlet Detail Report - Prime Bakes</PageTitle>

<MudBlazor.MudHotkey Key=JsKey.KeyN KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => WindowNavigation.NavigateToRoute(StoreRouteNames.Sale)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyF KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => _firstFocus?.FocusAsync()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.F5 OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyR KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="LoadTransactionOverviews" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.Delete KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleDeleted" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyQ KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleDetailsView" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyJ KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="ToggleAi" Disabled="@(_isProcessing || _user?.Admin != true)" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.ControlLeft] OnHotkeyPressed="() => ExportReport(true)" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyO KeyModifiers=[JsKeyModifier.AltLeft] OnHotkeyPressed="ViewSelectedTransaction" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyP KeyModifiers=[JsKeyModifier.AltLeft] OnHotkeyPressed="() => ExportSelectedTransaction()" Disabled="@_isProcessing" />
<MudBlazor.MudHotkey Key=JsKey.KeyE KeyModifiers=[JsKeyModifier.AltLeft] OnHotkeyPressed="() => ExportSelectedTransaction(true)" Disabled="@_isProcessing" />

@if (_isLoading || _user is null)
{
	<LoadingScreen />
}
else
{
	<div class="page-shell">
		<Header Title="Outlet Detail Report">
			<LeftContent>
				<MudBlazor.MudMenu Label="File" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="New Transaction (Ctrl + N)" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.Sale)" />
					<MudBlazor.MudMenuItem Label="Refresh Data (Ctrl + R / F5)" OnClick="LoadTransactionOverviews" />
					<MudBlazor.MudMenuItem Label="@(_showDeleted ? "Hide Deleted (Ctrl + Delete)" : "Show Deleted (Ctrl + Delete)")" OnClick="ToggleDeleted" />
					<MudBlazor.MudMenuItem Label="@(_showAllColumns ? "Hide Details (Ctrl + Q)" : "Show Details (Ctrl + Q)")" OnClick="ToggleDetailsView" />
					@if (_user.Admin)
					{
						<MudBlazor.MudMenuItem Label="@(_showAi ? "Hide AI Insights (Ctrl + J)" : "Show AI Insights (Ctrl + J)")" OnClick="ToggleAi" />
					}
					<MudBlazor.MudDivider />
					<MudBlazor.MudMenuItem Label="Export PDF (Ctrl + P)" OnClick="() => ExportReport()" />
					<MudBlazor.MudMenuItem Label="Export Excel (Ctrl + E)" OnClick="() => ExportReport(true)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Open" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Accounting Report" OnClick="() => WindowNavigation.NavigateToRoute(AccountsRouteNames.FinancialAccountingReport)" />
					<MudBlazor.MudMenuItem Label="Ledger Report" OnClick="() => WindowNavigation.NavigateToRoute(AccountsRouteNames.AccountingLedgerReport)" />
					<MudBlazor.MudMenuItem Label="Order Report" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.OrderReport)" />
					<MudBlazor.MudMenuItem Label="Order Item Report" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.OrderItemReport)" />
					<MudBlazor.MudMenuItem Label="Sale (Ctrl + N)" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.Sale)" />
					<MudBlazor.MudMenuItem Label="Sale Report" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.SaleReport)" />
					<MudBlazor.MudMenuItem Label="Sale Item Report" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.SaleItemReport)" />
					<MudBlazor.MudMenuItem Label="Sale Return Report" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.SaleReturnReport)" />
					<MudBlazor.MudMenuItem Label="Sale Return Item Report" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.SaleReturnItemReport)" />
					<MudBlazor.MudMenuItem Label="Stock Transfer Report" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.StockTransferReport)" />
					<MudBlazor.MudMenuItem Label="Stock Transfer Item Report" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.StockTransferItemReport)" />
					<MudBlazor.MudMenuItem Label="Bill Report" OnClick="() => WindowNavigation.NavigateToRoute(RestaurantRouteNames.BillReport)" />
					<MudBlazor.MudMenuItem Label="Bill Item Report" OnClick="() => WindowNavigation.NavigateToRoute(RestaurantRouteNames.BillItemReport)" />
					<MudBlazor.MudMenuItem Label="Product Location" OnClick="() => WindowNavigation.NavigateToRoute(StoreRouteNames.ProductLocation)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Periods" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="Today" OnClick="() => HandleDatesChanged(DateRangeType.Today)" />
					<MudBlazor.MudMenuItem Label="Previous Day" OnClick="() => HandleDatesChanged(DateRangeType.Yesterday)" />
					<MudBlazor.MudMenuItem Label="Next Day" OnClick="() => HandleDatesChanged(DateRangeType.NextDay)" />
					<MudBlazor.MudMenuItem Label="Current Month" OnClick="() => HandleDatesChanged(DateRangeType.CurrentMonth)" />
					<MudBlazor.MudMenuItem Label="Previous Month" OnClick="() => HandleDatesChanged(DateRangeType.PreviousMonth)" />
					<MudBlazor.MudMenuItem Label="Next Month" OnClick="() => HandleDatesChanged(DateRangeType.NextMonth)" />
					<MudBlazor.MudMenuItem Label="Current FY" OnClick="() => HandleDatesChanged(DateRangeType.CurrentFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Previous FY" OnClick="() => HandleDatesChanged(DateRangeType.PreviousFinancialYear)" />
					<MudBlazor.MudMenuItem Label="Next FY" OnClick="() => HandleDatesChanged(DateRangeType.NextFinancialYear)" />
					<MudBlazor.MudMenuItem Label="All Time" OnClick="() => HandleDatesChanged(DateRangeType.AllTime)" />
				</MudBlazor.MudMenu>

				<MudBlazor.MudMenu Label="Transaction" Dense="true" Disabled="_isProcessing">
					<MudBlazor.MudMenuItem Label="View (Alt + O)" OnClick="ViewSelectedTransaction" />
					<MudBlazor.MudMenuItem Label="Export PDF (Alt + P)" OnClick="() => ExportSelectedTransaction()" />
					<MudBlazor.MudMenuItem Label="Export Excel (Alt + E)" OnClick="() => ExportSelectedTransaction(true)" />
				</MudBlazor.MudMenu>
			</LeftContent>
		</Header>

		<div class="page-container outlet-tabs">

			<div class="section-card">
				<div class="section-header">
					<h2 class="section-title">Filters</h2>
				</div>

				<div class="section-body">
					<div class="filters-grid">
						<!-- Date Range -->
						<div class="form-field">
							<CustomDateRangePicker @ref="_firstFocus" Value="@(new MudBlazor.DateRange(_fromDate, _toDate))"
												   ValueChanged="OnDateRangeChanged"
												   Label="Date Range (Ctrl + F)"
												   Required="false" />
						</div>

						<!-- Location -->
						<div class="form-field">
							<CustomAutoComplete T="LocationModel"
												Value="_selectedLocation"
												DataSource="@_locations"
												Placeholder="Select Location"
												Label="Location" Required="true"
												ValueChanged="OnLocationChanged"
												FieldValue="@nameof(LocationModel.Name)"
												AddNewRoute="@OperationRouteNames.Location" />
						</div>
					</div>
				</div>
			</div>

			@if (_user.Admin && _showAi)
			{
				<ReportAi Instructions="@AiInstructions" GetContext="BuildAiContext"
						  ReportName="@StoreRouteNames.OutletDetailReport" UserId="@_user.Id"
						  DefaultQuestion="@AiDefaultQuestion" Suggestions="@AiSuggestions" />
			}

			<MudBlazor.MudTabs @bind-ActivePanelIndex="_activeTabIndex"
							   Rounded="true"
							   Color="MudBlazor.Color.Transparent"
							   SliderColor="MudBlazor.Color.Primary"
							   MinimumTabWidth="120px"
							   ApplyEffectsToContainer="false"
							   TabHeaderClass="outlet-tab-header"
							   TabPanelsClass="outlet-tab-panels">

				<MudBlazor.MudTabPanel Text="Accounting">
					<div class="section-card">
						<div class="section-header">
							<h2 class="section-title">Records</h2>
						</div>

						<SfGrid @ref="_accountingGrid" TValue="FinancialAccountingOverviewModel" DataSource="_accountings"
								AllowTextWrap="true" AllowPaging="true" AllowSorting="true" AllowResizing="true"
								AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
								GridLines="GridLine.Horizontal" ContextMenuItems="@_gridContextMenuItems"
								Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

							<GridEvents TValue="FinancialAccountingOverviewModel" ContextMenuItemClicked="OnAccountingContextMenuItemClicked" />
							<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
							<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

							<GridAggregates>
								<GridAggregate>
									<GridAggregateColumns>
										<GridColumnAggregate Field="@nameof(FinancialAccountingOverviewModel.TransactionNo)" Type="AggregateType.Count" Format="N0" />
										<GridColumnAggregate Field="@nameof(FinancialAccountingOverviewModel.TotalLedgers)" />
										<GridColumnAggregate Field="@nameof(FinancialAccountingOverviewModel.TotalDebitLedgers)" CustomColor="grid-debit" />
										<GridColumnAggregate Field="@nameof(FinancialAccountingOverviewModel.TotalCreditLedgers)" CustomColor="grid-credit" />
										<GridColumnAggregate Field="@nameof(FinancialAccountingOverviewModel.TotalDebitAmount)" CustomColor="grid-debit" />
										<GridColumnAggregate Field="@nameof(FinancialAccountingOverviewModel.TotalCreditAmount)" CustomColor="grid-credit" />
										<GridColumnAggregate Field="@nameof(FinancialAccountingOverviewModel.TotalAmount)" CustomColor="grid-total" />
									</GridAggregateColumns>
								</GridAggregate>
							</GridAggregates>

							<GridColumns>
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.TransactionNo)" HeaderText="Transaction No" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.TransactionDateTime)" HeaderText="Date" Format="dd/MM/yy" Type="ColumnType.DateTime" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.CompanyName)" HeaderText="Company" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.VoucherName)" HeaderText="Voucher Type" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.ReferenceNo)" HeaderText="Ref No" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.FinancialYear)" HeaderText="Financial Year" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.TotalLedgers)" HeaderText="Ledgers" NumericColumn="true" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.TotalDebitLedgers)" HeaderText="Debit Ledgers" Visible="@_showAllColumns" CustomColor="grid-debit" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.TotalCreditLedgers)" HeaderText="Credit Ledgers" Visible="@_showAllColumns" CustomColor="grid-credit" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.TotalDebitAmount)" HeaderText="Total Debit" CustomColor="grid-debit" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.TotalCreditAmount)" HeaderText="Total Credit" CustomColor="grid-credit" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.TotalAmount)" HeaderText="Amount" TotalColumn="true" />

								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.Remarks)" HeaderText="Remarks" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.CreatedByName)" HeaderText="Created By" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.CreatedAt)" HeaderText="Created At" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.LastModifiedByUserName)" HeaderText="Modified By" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.LastModifiedAt)" HeaderText="Modified At" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(FinancialAccountingOverviewModel.Status)" Visible="@_showDeleted" StatusColumn="true" />
							</GridColumns>
						</SfGrid>
					</div>
				</MudBlazor.MudTabPanel>

				<MudBlazor.MudTabPanel Text="Ledger">
					<div class="section-card">
						<div class="section-header">
							<h2 class="section-title">Records</h2>
						</div>

						<SfGrid @ref="_ledgerGrid" TValue="FinancialAccountingLedgerOverviewModel" DataSource="_ledgerEntries"
								AllowTextWrap="true" AllowPaging="true" AllowSorting="true" AllowResizing="true"
								AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
								GridLines="GridLine.Horizontal" ContextMenuItems="@_gridContextMenuItems"
								Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

							<GridEvents TValue="FinancialAccountingLedgerOverviewModel" ContextMenuItemClicked="OnLedgerContextMenuItemClicked" />
							<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
							<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

							<GridAggregates>
								<GridAggregate>
									<GridAggregateColumns>
										<GridColumnAggregate Field="@nameof(FinancialAccountingLedgerOverviewModel.LedgerName)" Type="AggregateType.Count" Format="N0" />
										<GridColumnAggregate Field="@nameof(FinancialAccountingLedgerOverviewModel.Debit)" CustomColor="grid-debit" />
										<GridColumnAggregate Field="@nameof(FinancialAccountingLedgerOverviewModel.Credit)" CustomColor="grid-credit" />
									</GridAggregateColumns>
								</GridAggregate>
							</GridAggregates>

							<GridColumns>
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.LedgerName)" HeaderText="Ledger" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.LedgerReferenceType)" HeaderText="Ref Type" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.LedgerReferenceNo)" HeaderText="Ref No" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.InstrumentNo)" HeaderText="Instrument No" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.InstrumentDate)" HeaderText="Instrument Date" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.ClearingDate)" HeaderText="Clearing Date" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.Reconciled)" HeaderText="Reconciled" TextAlign="TextAlign.Center" Visible="@_showAllColumns" DisplayAsCheckBox="true" />

								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.Debit)" HeaderText="Debit" CustomColor="grid-debit" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.Credit)" HeaderText="Credit" CustomColor="grid-credit" />

								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.LedgerRemarks)" HeaderText="Ledger Remarks" Width="500" />

								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.TransactionNo)" HeaderText="Transaction No" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.TransactionDateTime)" HeaderText="Date" Format="dd/MM/yy" Type="ColumnType.DateTime" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.CompanyName)" HeaderText="Company" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.VoucherName)" HeaderText="Voucher Type" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.ReferenceNo)" HeaderText="Ref No" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.FinancialYear)" HeaderText="Financial Year" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.Remarks)" HeaderText="Remarks" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.CreatedByName)" HeaderText="Created By" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.CreatedAt)" HeaderText="Created At" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.LastModifiedByUserName)" HeaderText="Modified By" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.LastModifiedAt)" HeaderText="Modified At" Format="dd/MM/yy" Type="ColumnType.DateTime" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(FinancialAccountingLedgerOverviewModel.MasterStatus)" Visible="@_showDeleted" StatusColumn="true" />
							</GridColumns>
						</SfGrid>
					</div>
				</MudBlazor.MudTabPanel>

				<MudBlazor.MudTabPanel Text="Products">
					<div class="section-card">
						<div class="section-header">
							<h2 class="section-title">Records</h2>
						</div>

						<SfGrid @ref="_productLocationGrid" TValue="ProductLocationOverviewModel" DataSource="_productLocations"
								AllowTextWrap="true" AllowPaging="true" AllowSorting="true" AllowResizing="true"
								AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
								GridLines="GridLine.Horizontal"
								Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

							<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
							<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

							<GridAggregates>
								<GridAggregate>
									<GridAggregateColumns>
										<GridColumnAggregate Field="@nameof(ProductLocationOverviewModel.Name)" Type="AggregateType.Count" Format="N0" />
									</GridAggregateColumns>
								</GridAggregate>
							</GridAggregates>

							<GridColumns>
								<CustomGridColumn Field="@nameof(ProductLocationOverviewModel.Code)" HeaderText="Product Code" />
								<CustomGridColumn Field="@nameof(ProductLocationOverviewModel.Name)" HeaderText="Product Name" />
								<CustomGridColumn Field="@nameof(ProductLocationOverviewModel.Rate)" HeaderText="Rate" NumericColumn="true" />
								<CustomGridColumn Field="@nameof(ProductLocationOverviewModel.FromDate)" HeaderText="Effective Date" Format="dd/MM/yy" Type="ColumnType.DateOnly" TextAlign="TextAlign.Center" />
							</GridColumns>
						</SfGrid>
					</div>
				</MudBlazor.MudTabPanel>

				<MudBlazor.MudTabPanel Text="Order">
					<div class="section-card">
						<div class="section-header">
							<h2 class="section-title">Records</h2>
						</div>

						<SfGrid @ref="_orderGrid" TValue="OrderOverviewModel" DataSource="_orders"
								AllowTextWrap="true" AllowPaging="true" AllowSorting="true" AllowResizing="true"
								AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
								GridLines="GridLine.Horizontal" ContextMenuItems="@_gridContextMenuItems"
								Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

							<GridEvents TValue="OrderOverviewModel" ContextMenuItemClicked="OnOrderContextMenuItemClicked" />
							<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
							<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

							<GridAggregates>
								<GridAggregate>
									<GridAggregateColumns>
										<GridColumnAggregate Field="@nameof(OrderOverviewModel.TransactionNo)" Type="AggregateType.Count" Format="N0" />
										<GridColumnAggregate Field="@nameof(OrderOverviewModel.TotalItems)" />
										<GridColumnAggregate Field="@nameof(OrderOverviewModel.TotalQuantity)" CustomColor="grid-total" />
									</GridAggregateColumns>
								</GridAggregate>
							</GridAggregates>

							<GridColumns>
								<CustomGridColumn Field="@nameof(OrderOverviewModel.TransactionNo)" HeaderText="Transaction No" />
								<CustomGridColumn Field="@nameof(OrderOverviewModel.TransactionDateTime)" HeaderText="Date" Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime" />
								<CustomGridColumn Field="@nameof(OrderOverviewModel.SaleTransactionNo)" HeaderText="Sale No" />
								<CustomGridColumn Field="@nameof(OrderOverviewModel.CompanyName)" HeaderText="Company" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(OrderOverviewModel.FinancialYear)" HeaderText="Financial Year" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(OrderOverviewModel.TotalItems)" HeaderText="Items" Visible="@_showAllColumns" NumericColumn="true" />
								<CustomGridColumn Field="@nameof(OrderOverviewModel.TotalQuantity)" HeaderText="Quantity" TotalColumn="true" />

								<CustomGridColumn Field="@nameof(OrderOverviewModel.Remarks)" HeaderText="Remarks" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(OrderOverviewModel.CreatedByName)" HeaderText="Created By" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(OrderOverviewModel.CreatedAt)" HeaderText="Created At" Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(OrderOverviewModel.LastModifiedByUserName)" HeaderText="Modified By" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(OrderOverviewModel.LastModifiedAt)" HeaderText="Modified At" Format="dd/MM/yy hh:mm tt" Type="ColumnType.DateTime" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(OrderOverviewModel.Status)" Visible="@_showDeleted" StatusColumn="true" />
							</GridColumns>
						</SfGrid>
					</div>
				</MudBlazor.MudTabPanel>

				<MudBlazor.MudTabPanel Text="Order Items">
					<div class="section-card">
						<div class="section-header">
							<h2 class="section-title">Records</h2>
						</div>

						<SfGrid @ref="_orderItemGrid" TValue="OrderItemOverviewModel" DataSource="_orderItems"
								AllowTextWrap="true" AllowPaging="true" AllowSorting="true" AllowResizing="true"
								AllowFiltering="true" AllowReordering="true" AllowGrouping="true" ShowColumnChooser="true"
								GridLines="GridLine.Horizontal" ContextMenuItems="@_gridContextMenuItems"
								Toolbar="@(new List<string>() { "ColumnChooser", "Search" })">

							<GridEvents TValue="OrderItemOverviewModel" ContextMenuItemClicked="OnOrderItemContextMenuItemClicked" />
							<GridPageSettings PageSize="20" PageSizes="@(new string[] { "20", "50", "100", "200", "All" })" />
							<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

							<GridAggregates>
								<GridAggregate>
									<GridAggregateColumns>
										<GridColumnAggregate Field="@nameof(OrderItemOverviewModel.ItemName)" Type="AggregateType.Count" Format="N0" />
										<GridColumnAggregate Field="@nameof(OrderItemOverviewModel.Quantity)" CustomColor="grid-total" />
									</GridAggregateColumns>
								</GridAggregate>
							</GridAggregates>

							<GridColumns>
								<CustomGridColumn Field="@nameof(OrderItemOverviewModel.ItemName)" HeaderText="Item" />
								<CustomGridColumn Field="@nameof(OrderItemOverviewModel.ItemCode)" HeaderText="Code" Visible="@_showAllColumns" />
								<CustomGridColumn Field="@nameof(OrderItemOverviewModel.ItemCategoryName)" HeaderText="Category" />
								<CustomGridColumn Field="@nameof(OrderItemOverviewModel.ItemRemarks)" HeaderText="Item Remarks" Visible="@_showAllColumns" />

								<CustomGridColumn Field="@nameof(OrderItemOverviewModel.Quantity)" HeaderText="Quantity" TotalColumn="true" />

